# ---------------------------------------------------------------------------
# Cadence — environment variables
#
# Copy to `.env.local` for Next.js, and `.env` for the CLI scripts
# (migrate / seed / reconcile / verify). Both files are gitignored.
#
#   cp .env.example .env.local
#   cp .env.example .env
#
# This project develops against a HOSTED Supabase project. There is no local
# Docker stack; `supabase start` is not part of the workflow.
# ---------------------------------------------------------------------------

# --- App ------------------------------------------------------------------

# Canonical origin of the running app. Stripe redirects (checkout success /
# cancel, customer portal return) are built from this, so it must match the
# host you actually browse to — including the port.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Supabase -------------------------------------------------------------
#
# All four values come from the hosted project dashboard at
# https://supabase.com/dashboard/project/<project-ref>

# Project URL. Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key. Settings -> API -> Project API keys -> anon public.
# Safe to ship to the browser: every request made with it is subject to Row
# Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Settings -> API -> Project API keys -> service_role.
# BYPASSES Row Level Security. Server-only — never import it into a client
# component, never expose it via NEXT_PUBLIC_. Used exclusively by: the Stripe
# webhook handler, the reconciliation job, the seed script and the /admin area.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Used by Drizzle, the migration runner and
# the RLS verification script — which needs to SET ROLE, something PostgREST
# cannot do.
#
# Settings -> Database -> Connection string. Three options are offered; the
# choice matters:
#
#   Session pooler   port 5432, host aws-N-<region>.pooler.supabase.com
#                    username postgres.<project-ref>
#                    ** USE THIS ONE. ** Reachable over IPv4, and it keeps
#                    session-level features (SET ROLE, advisory locks, SET
#                    LOCAL) that the migrations and the RLS checks depend on.
#
#   Direct           port 5432, host db.<project-ref>.supabase.co
#                    Equivalent in capability, but IPv6-only unless the project
#                    has the IPv4 add-on. Fine if your network has IPv6.
#
#   Transaction pooler  port 6543
#                    Do NOT use for migrations or the verification script.
#                    Statements are multiplexed across backends, so SET ROLE
#                    and session state do not survive between statements.
#
# Remember to URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Safety interlock for `pnpm db:reset`, which drops every Cadence table and
# deletes the demo auth users. Because the development database is hosted
# rather than a disposable local container, the destructive target has to be
# named explicitly: set this to the exact host from DATABASE_URL above.
# Point DATABASE_URL somewhere else without updating this, and reset refuses.
# Leave it empty to disable `db:reset` entirely.
CADENCE_DESTRUCTIVE_OK=aws-0-eu-west-1.pooler.supabase.com


# --- Stripe ---------------------------------------------------------------
#
# Stripe dashboard -> Developers -> API keys. Use TEST mode keys (sk_test_…).
# Everything in this repo is built and demoed against test mode.

# Secret key. Server-only.
STRIPE_SECRET_KEY=sk_test_

# Publishable key. Safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Webhook signing secret.
#   Local:  printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#           as "Your webhook signing secret is whsec_…". It is regenerated on
#           every `stripe listen`, so re-copy it when you restart the CLI.
#   Hosted: Stripe dashboard -> Developers -> Webhooks -> your endpoint ->
#           "Signing secret".
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe Customer Portal configuration id (cfg_…). Optional: if unset the
# account's default portal configuration is used. Created by
# `pnpm stripe:sync-plans`, which prints the id.
STRIPE_PORTAL_CONFIGURATION_ID=


# --- Billing behaviour ----------------------------------------------------
#
# These are defaults written into the `billing_config` row on first migrate.
# Once seeded, the database row wins — change it there (or in /admin) rather
# than redeploying. They are read from env only at bootstrap time.

# Days a past_due workspace keeps paid access before auto-downgrade to Free.
BILLING_GRACE_PERIOD_DAYS=7

# Shared secret for the cron-triggered jobs (reconciliation, grace sweeper).
# Vercel Cron sends it as `Authorization: Bearer <value>`. Generate with:
#   openssl rand -hex 32
CRON_SECRET=


# --- Admin ----------------------------------------------------------------

# Comma-separated list of emails allowed into /admin. Matched case-insensitively
# against the signed-in user. Mirrored into `profiles.is_platform_admin` by the
# seed script; this env var is the bootstrap source of truth.
ADMIN_EMAILS=admin@cadence.test
